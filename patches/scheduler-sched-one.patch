+// NodeResourceSnapshot reports scheduler-cache resources for diagnostics.
+type NodeResourceSnapshot struct {
+	AllocatableMilliCPU int64
+	RequestedMilliCPU int64
+	AllocatableMemory int64
+	RequestedMemory int64
+}
+
+func (sched *Scheduler) NodeResourceSnapshots() map[string]NodeResourceSnapshot {
+	result := make(map[string]NodeResourceSnapshot)
+	nodeInfos, _ := sched.nodeInfoSnapshot.NodeInfos().List()
+	for _, nodeInfo := range nodeInfos {
+		allocatable := nodeInfo.GetAllocatable()
+		requested := nodeInfo.GetRequested()
+		result[nodeInfo.Node().Name] = NodeResourceSnapshot{AllocatableMilliCPU: allocatable.GetMilliCPU(), RequestedMilliCPU: requested.GetMilliCPU(), AllocatableMemory: allocatable.GetMemory(), RequestedMemory: requested.GetMemory()}
+	}
+	return result
+}
+
