 	clusterNetworkConfig *cluster.NetworkConfig
+
+	// overlaid is this provider behind Karpenter's NodeOverlay decorator. Create
+	// reads the launched instance type through it, so that the NodeClaim reports
+	// the capacity the scheduler planned with.
+	overlaid cloudprovider.CloudProvider
+}
+
+// SetOverlaidCloudProvider hands the NodeOverlay-decorated provider back to the
+// provider it wraps.
+func (c *CloudProvider) SetOverlaidCloudProvider(overlaid cloudprovider.CloudProvider) {
+	c.overlaid = overlaid
+}
+
+// addOverlayCapacity adds the resources a NodeOverlay declares for the launched
+// instance type to the capacity of the created NodeClaim. Without them the
+// NodeClaim of an instance that has not registered yet looks too small for the
+// pod it was launched for (a pod requesting an overlay-only extended resource),
+// and every provisioning round launches one more instance for the same pod
+// until the NodePool limit is reached.
+func (c *CloudProvider) addOverlayCapacity(ctx context.Context, requested, created *coreapis.NodeClaim) {
+	nodePoolName := requested.Labels[coreapis.NodePoolLabelKey]
+	if c.overlaid == nil || nodePoolName == "" || created == nil {
+		return
+	}
+	nodePool := &coreapis.NodePool{}
+	if err := c.kubeClient.Get(ctx, client.ObjectKey{Name: nodePoolName}, nodePool); err != nil {
+		log.FromContext(ctx).Error(err, "reading the NodePool for overlay capacity", "nodePool", nodePoolName)
+		return
+	}
+	instanceTypes, err := c.overlaid.GetInstanceTypes(ctx, nodePool)
+	if err != nil {
+		log.FromContext(ctx).Error(err, "listing overlaid instance types", "nodePool", nodePoolName)
+		return
+	}
+	launched := created.Labels[corev1.LabelInstanceTypeStable]
+	for _, it := range instanceTypes {
+		if it.Name != launched {
+			continue
+		}
+		allocatable := it.Allocatable()
+		for name, quantity := range it.Capacity {
+			if _, known := created.Status.Capacity[name]; known {
+				continue
+			}
+			if created.Status.Capacity == nil {
+				created.Status.Capacity = corev1.ResourceList{}
+			}
+			if created.Status.Allocatable == nil {
+				created.Status.Allocatable = corev1.ResourceList{}
+			}
+			created.Status.Capacity[name] = quantity.DeepCopy()
+			if alloc, ok := allocatable[name]; ok {
+				created.Status.Allocatable[name] = alloc.DeepCopy()
+			} else {
+				created.Status.Allocatable[name] = quantity.DeepCopy()
+			}
+		}
+		return
+	}
 }
 
